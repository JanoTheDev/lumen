{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumen/lesson.schema.json",
  "title": "Lesson (skills/<app-id>/lessons/<id>.lesson.json)",
  "type": "object",
  "required": ["id", "app", "title", "level", "minutes", "prereqs", "appVersion", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]+-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "app": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 50 },
    "summary": { "type": "string", "maxLength": 200 },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "prereqs": { "type": "array", "items": { "type": "string" } },
    "appVersion": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "say", "target", "hints", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "say": { "type": "string", "minLength": 3, "maxLength": 200 },
        "target": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/target" }]
        },
        "expect": { "$ref": "#/$defs/expect" },
        "hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 3, "maxLength": 240 }
        },
        "why": { "type": "string", "minLength": 3, "maxLength": 200 },
        "doItForMe": {
          "type": "object",
          "required": ["actions"],
          "additionalProperties": false,
          "properties": {
            "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
          }
        },
        "timeoutSec": { "type": "integer", "minimum": 10, "maximum": 900 }
      }
    },
    "elementQuery": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "automationId": { "type": "string", "minLength": 1 },
        "nth": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["element"],
          "additionalProperties": false,
          "properties": { "element": { "$ref": "#/$defs/elementQuery" } }
        },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "nth": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["region"],
          "additionalProperties": false,
          "properties": { "region": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["shortcut"],
          "additionalProperties": false,
          "properties": { "shortcut": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["mark"],
          "additionalProperties": false,
          "properties": { "mark": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "required": ["point"],
          "additionalProperties": false,
          "properties": {
            "point": {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
            }
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "required": ["type", "check"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "user-action" },
        "check": {
          "oneOf": [
            {
              "enum": ["uia-event", "window-title", "vision", "bridge", "keypress", "manual"]
            },
            { "$ref": "#/$defs/check" }
          ]
        },
        "prompt": { "type": "string", "minLength": 3 }
      }
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "event", "match"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "uia-event" },
            "event": { "enum": ["invoked", "focused", "value", "selected", "window-opened"] },
            "changed": { "const": true },
            "absent": { "const": true },
            "match": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "automationId": { "type": "string" },
                "value": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["regex"],
                      "additionalProperties": false,
                      "properties": { "regex": { "type": "string", "minLength": 1 } }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "regex"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "window-title" },
            "regex": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "prompt"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "vision" },
            "prompt": { "type": "string", "minLength": 10 }
          }
        },
        {
          "type": "object",
          "required": ["type", "app", "expect"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "bridge" },
            "app": { "type": "string", "minLength": 1 },
            "expect": { "type": "object", "minProperties": 1 },
            "since": { "const": "lesson" }
          }
        },
        {
          "type": "object",
          "required": ["type", "combo"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "keypress" },
            "combo": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "manual" } }
        },
        {
          "type": "object",
          "required": ["type", "checks"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["anyOf", "allOf"] },
            "checks": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/check" } }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "combo"],
          "additionalProperties": false,
          "properties": { "t": { "const": "keys" }, "combo": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["t", "text"],
          "additionalProperties": false,
          "properties": { "t": { "const": "type" }, "text": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["t", "region"],
          "additionalProperties": false,
          "properties": { "t": { "const": "move" }, "region": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["t"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "click" },
            "button": { "enum": ["left", "right", "middle"] },
            "count": { "type": "integer", "minimum": 1, "maximum": 3 },
            "region": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["t", "dx", "dy"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "scroll" },
            "dx": { "type": "integer" },
            "dy": { "type": "integer" },
            "region": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["t", "ms"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "wait" },
            "ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        {
          "type": "object",
          "required": ["t", "url"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "open_url" },
            "url": { "type": "string", "pattern": "^(https://|ms-settings:)" }
          }
        },
        {
          "type": "object",
          "required": ["t", "element"],
          "additionalProperties": false,
          "properties": {
            "t": { "const": "invoke" },
            "element": { "$ref": "#/$defs/elementQuery" }
          }
        }
      ]
    }
  }
}
