{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumen/skill.schema.json",
  "title": "Skill pack manifest (skills/<app-id>/skill.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "match",
    "uiaQuality",
    "appVersion",
    "appVersionTested",
    "lastVerified"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "maxLength": 200 },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "url": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "uiaQuality": { "enum": ["good", "partial", "none"] },
    "bridge": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version range the lessons are written for, e.g. \">=4.2\"."
    },
    "appVersionTested": {
      "type": "string",
      "minLength": 1,
      "description": "Exact version or build the content was checked against."
    },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifiedBy": {
      "enum": ["docs", "walkthrough"],
      "description": "docs = checked against official documentation; walkthrough = every lesson played on a real install."
    },
    "notes": { "type": "string" }
  }
}
